{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "rewrites": [
        { "source": "/backend/:path(.*)?", "destination": "/api/v1/:path" }
      ]
    }
  },
  "rewrites": [
    { "source": "/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
